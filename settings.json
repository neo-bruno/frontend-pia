{
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "prettier.printWidth": 140,
  "prettier.singleAttributePerLine": false,
  "prettier.bracketSameLine": true,
  "prettier.semi": true,
  "prettier.singleQuote": false,
  "prettier.tabWidth": 2
}